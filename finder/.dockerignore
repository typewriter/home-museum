# 先頭の / は不要 (.dockerignore は再帰的に効かない) だが、internal/imagecache/ を
# 巻き込まない意図を明示するために付けておく。

# DB もキャッシュもイメージには入れない (volume で渡す)。
/index.db
/index.db-wal
/index.db-shm
/index.db.building*
/cache.db
/cache.db-wal
/cache.db-shm
/imagecache/
/localcache/

# ビルド成果物とドキュメント
/finder
/*.md
/Dockerfile
/docker-compose.yml
/compose.https.yml

# 環境変数
.env
