*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# Used by dotenv library to load environment variables.
# .env

# Ignore Byebug command history file.
.byebug_history

## Specific to RubyMotion:
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

## Specific to RubyMotion (use of CocoaPods):
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# vendor/Pods/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

# Crawler LMDB stores (raw crawl data, not source)
*.lmdb/

# SQLite output database (not part of the repo)
# -wal/-shm are removed by DB.finalize, but linger if a script dies mid-run
*.db
*.db-wal
*.db-shm

# direnv local environment (contains secrets, e.g. PARIS_TOKEN)
.envrc

# Crawler resume markers
*.resume

# Title translation work files (regenerable from LMDB; the CSVs are the deliverable)
.title_translation_batch_*.json
.title_translation_targets_*
.author_merge_batch.json

# with_llms/: kept locally, not tracked (translation data, LLM prompts, go build output)
with_llms/titles_ja_*.csv
with_llms/*_prompt.md
with_llms/*/prompt.md
with_llms/title_translator/title_translator
with_llms/author_merger/author_merger
# title_translator の -out の既定値 (翻訳結果JSONの置き場。CSV に追記した後は捨ててよい)
with_llms/scratch/

# LLM による名寄せ判定の正本。titles_ja_*.csv と同じくローカルに置き、追跡しない
author_merges.csv

# 使い捨ての作業ファイル (検証スクリプト、CSV に追記済みの翻訳結果JSON)
scratch/
translations-*.json
